# Copy to .env and fill in JWT_SECRET:
#   cp .env.example .env
#   sed -i.bak "s|^JWT_SECRET=.*|JWT_SECRET=$(openssl rand -hex 32)|" .env && rm .env.bak

# REQUIRED: HMAC-SHA256 signing key, at least 32 bytes. Never commit the real value.
JWT_SECRET=

JWT_ISSUER=user-management-api
JWT_TTL=1h

HTTP_ADDR=:8080
GRPC_ADDR=:50051

# Used when running on the host. docker-compose overrides this for the container.
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=user_management

USER_COUNT_INTERVAL=10s
